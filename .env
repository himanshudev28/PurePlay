# Local dev config. Vite reads this (not .env.example).

# Direct-audio catalog so playback works in the background.
VITE_MUSIC_SOURCE=jiosaavn

# Listening rooms sync over a public MQTT broker by default — no server to run,
# works on Vercel. Uncomment to use your own broker or the self-hosted relay:
# VITE_ROOM_BROKER=wss://your-broker:8084/mqtt
# VITE_ROOM_WS=ws://localhost:8787   # then run: npm run room

# Local dev config. Vite reads this (not .env.example).

# Direct-audio catalog so playback works in the background (see .env.example).
VITE_MUSIC_SOURCE=jiosaavn

# Listening-room sync server. Run it with: npm run room
# The app falls back to same-device (cross-tab) sync if this is unreachable.
VITE_ROOM_WS=ws://localhost:8787

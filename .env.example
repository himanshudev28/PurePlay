# Which catalog adapter powers search + home:
#   "jiosaavn" (DEFAULT) — universal catalog, 320kbps direct streams, offline downloads.
#   "audius" / "jamendo" — smaller catalogs, also direct streams + offline.
#   "youtube"            — universal catalog, but plays through an iframe.
#
# BACKGROUND PLAYBACK (screen off / app backgrounded on mobile):
#   jiosaavn / audius / jamendo play through a real <audio> element, so they keep
#   playing with the screen off and expose lock-screen controls (Android; limited
#   on iOS). YouTube's iframe is PAUSED by mobile browsers when the screen turns
#   off — leave this unset (or use a direct-audio source) if background play matters.
VITE_MUSIC_SOURCE=jiosaavn

# REQUIRED only for the YouTube adapter.
# console.cloud.google.com -> new project -> enable "YouTube Data API v3" -> create API key
# Free tier is 10,000 units/day; a search costs 100, so ~100 searches/day.
VITE_YOUTUBE_API_KEY=

# Region for the YouTube trending chart (ISO 3166-1 alpha-2)
VITE_YOUTUBE_REGION=IN

# Jamendo needs a free client id - https://devportal.jamendo.com
VITE_JAMENDO_CLIENT_ID=

# Websocket server for multi-user listening rooms.
# Leave empty to sync across tabs on one device (BroadcastChannel fallback).
VITE_ROOM_WS=
